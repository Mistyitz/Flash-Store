
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flash Store</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --border-color: #334155;
      --accent-color: #38bdf8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* Header Styling */
    header {
      background-color: #1a2332;
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Rainbow Lightning Bolt SVG */
    .rainbow-bolt {
      width: 32px;
      height: 32px;
      filter: drop-shadow(0px 0px 6px rgba(255, 255, 255, 0.3));
    }

    .brand-title {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(45deg, #ff4500, #ffa500, #00e676, #00e5ff, #d500f9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Navigation Tabs */
    nav {
      background-color: #151d2a;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: center;
      gap: 20px;
    }

    .nav-tab {
      padding: 14px 24px;
      background: none;
      border: none;
      color: var(--text-sub);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      position: relative;
      transition: color 0.2s ease;
    }

    .nav-tab:hover {
      color: var(--text-main);
    }

    .nav-tab.active {
      color: var(--accent-color);
    }

    .nav-tab.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background-color: var(--accent-color);
      border-radius: 3px 3px 0 0;
    }

    /* Main Container */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      width: 100%;
      flex-grow: 1;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }

    /* Item Card Styling */
    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
    }

    .card-icon {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: linear-gradient(135deg, #334155, #0f172a);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin-bottom: 1rem;
      box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.05);
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
      width: 100%;
    }

    .card-type {
      font-size: 0.8rem;
      color: var(--text-sub);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 1rem;
    }

    .action-btn {
      width: 100%;
      padding: 8px 16px;
      border: none;
      border-radius: 20px;
      background-color: var(--accent-color);
      color: #0f172a;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: opacity 0.2s ease;
    }

    .action-btn:hover {
      opacity: 0.9;
    }

    /* Media Viewers */
    audio, video {
      width: 100%;
      margin-top: 10px;
      border-radius: 8px;
    }

    /* Loading / Status Indicators */
    .status-msg {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--text-sub);
      font-size: 1.1rem;
      padding: 3rem 0;
    }
  </style>
</head>
<body>

  <!-- Header section with Rainbow Lightning Bolt -->
  <header>
    <div class="brand">
      <svg class="rainbow-bolt" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="rainbowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ff0055" />
            <stop offset="25%" stop-color="#ff5000" />
            <stop offset="50%" stop-color="#ffcc00" />
            <stop offset="75%" stop-color="#00e676" />
            <stop offset="100%" stop-color="#00e5ff" />
          </linearGradient>
        </defs>
        <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="url(#rainbowGrad)" stroke="none"/>
      </svg>
      <h1 class="brand-title">Flash Store</h1>
    </div>
  </header>

  <!-- Google Play Style Tab Navigation -->
  <nav>
    <button class="nav-tab active" onclick="switchTab('apps')">Apps & Games</button>
    <button class="nav-tab" onclick="switchTab('videos')">Videos</button>
    <button class="nav-tab" onclick="switchTab('sounds')">Sounds</button>
  </nav>

  <!-- Main Content Areas -->
  <main>
    <div id="apps" class="tab-content active">
      <div class="status-msg">Loading contents from GitHub...</div>
    </div>
    <div id="videos" class="tab-content">
      <div class="status-msg">Loading videos...</div>
    </div>
    <div id="sounds" class="tab-content">
      <div class="status-msg">Loading sounds...</div>
    </div>
  </main>

  <script>
    const REPO_OWNER = 'Mistyitz';
    const REPO_NAME = 'Flash-Store';
    const API_URL = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents`;

    // Tab Switching Logic
    function switchTab(tabId) {
      document.querySelectorAll('.nav-tab').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      
      event.target.classList.add('active');
      document.getElementById(tabId).classList.add('active');
    }

    // Helper: Formats filename to strip extension
    function cleanName(filename) {
      return filename.substring(0, filename.lastIndexOf('.')) || filename;
    }

    // Fetch repository contents on load
    async function fetchRepositoryFiles() {
      const appsContainer = document.getElementById('apps');
      const videosContainer = document.getElementById('videos');
      const soundsContainer = document.getElementById('sounds');

      try {
        const response = await fetch(API_URL);
        if (!response.ok) throw new Error('Failed to fetch store contents');
        
        const files = await response.json();

        // Clear loading indicators
        appsContainer.innerHTML = '';
        videosContainer.innerHTML = '';
        soundsContainer.innerHTML = '';

        let counts = { apps: 0, videos: 0, sounds: 0 };

        files.forEach(file => {
          if (file.type !== 'file') return; // Skip directories

          const ext = file.name.split('.').pop().toLowerCase();
          const displayName = cleanName(file.name);
          const rawUrl = file.download_url;

          // 1. HTML and JS Files -> Apps & Games
          if (ext === 'html' || ext === 'js') {
            counts.apps++;
            appsContainer.appendChild(createAppCard(displayName, ext, rawUrl));
          } 
          // 2. MP4 Files -> Videos
          else if (ext === 'mp4') {
            counts.videos++;
            videosContainer.appendChild(createVideoCard(displayName, rawUrl));
          } 
          // 3. MP3 Files -> Sounds
          else if (ext === 'mp3') {
            counts.sounds++;
            soundsContainer.appendChild(createSoundCard(displayName, rawUrl));
          }
        });

        // Set empty states if no items match category
        if (counts.apps === 0) appsContainer.innerHTML = '<div class="status-msg">No apps or games found.</div>';
        if (counts.videos === 0) videosContainer.innerHTML = '<div class="status-msg">No videos found.</div>';
        if (counts.sounds === 0) soundsContainer.innerHTML = '<div class="status-msg">No audio files found.</div>';

      } catch (err) {
        console.error(err);
        const errorHTML = `<div class="status-msg" style="color: #ef4444;">Error loading Flash Store items. Please verify repository access.</div>`;
        appsContainer.innerHTML = errorHTML;
        videosContainer.innerHTML = errorHTML;
        soundsContainer.innerHTML = errorHTML;
      }
    }

    // Card UI Generator for Apps (.html, .js)
    function createAppCard(name, ext, url) {
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `
        <div class="card-icon">⚡</div>
        <div class="card-title" title="${name}">${name}</div>
        <div class="card-type">${ext.toUpperCase()} APP</div>
        <a href="${url}" target="_blank" class="action-btn">Launch</a>
      `;
      return card;
    }

    // Card UI Generator for Videos (.mp4)
    function createVideoCard(name, url) {
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `
        <div class="card-title" title="${name}">${name}</div>
        <div class="card-type">MP4 Video</div>
        <video controls preload="metadata">
          <source src="${url}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      `;
      return card;
    }

    // Card UI Generator for Sounds (.mp3)
    function createSoundCard(name, url) {
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `
        <div class="card-icon">🎵</div>
        <div class="card-title" title="${name}">${name}</div>
        <div class="card-type">MP3 Audio</div>
        <audio controls preload="none">
          <source src="${url}" type="audio/mpeg">
          Your browser does not support the audio element.
        </audio>
      `;
      return card;
    }

    // Initialize on page render
    window.addEventListener('DOMContentLoaded', fetchRepositoryFiles);
  </script>
</body>
</html>
